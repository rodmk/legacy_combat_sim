{
  "name": "legacy_combat_sim",
  "version": "1.0.0",
  "description": "Combat Simulator for Legacy (http://www.legacy-game.net)",
  "scripts": {
    "analyze:seed": "node scripts/analyze-seed-builds.js",
    "analyze:allocations": "node scripts/analyze-stat-allocations.js",
    "analyze:search-space": "node scripts/analyze-search-space.js",
    "analyze:regions": "node scripts/analyze-attainable-regions.js",
    "search:min-hp": "node scripts/search-minimum-hp.js",
    "search:stats": "node scripts/search-stat-allocations.js",
    "search:equipment": "node scripts/search-equipment-response.js",
    "search:equipment-beam": "node scripts/search-equipment-beam.js",
    "search:expand-equipment": "node scripts/expand-equipment-archive.js",
    "search:meta": "node scripts/search-meta.js",
    "export:meta": "node scripts/export-meta-search.js",
    "benchmark:joint-response": "node scripts/benchmark-joint-response.js",
    "benchmark:equipment-pass": "node scripts/benchmark-equipment-pass.js",
    "verify": "yarn test && yarn validate:data && yarn typecheck",
    "prepare": "husky",
    "test": "yarn test-eslint && yarn test-unittest",
    "test-eslint": "node_modules/eslint/bin/eslint.js combatsim.js scripts/* test/*",
    "test-unittest": "node_modules/nodeunit/bin/nodeunit test/*",
    "typecheck": "tsc --noEmit",
    "validate:data": "yarn validate:crystals && yarn validate:equipment && yarn validate:weapon-mods && yarn validate:builds && yarn validate:catalog-relations",
    "validate:crystals": "ajv validate --spec=draft2020 -s data/crystals.schema.json -d data/crystals.json",
    "validate:equipment": "ajv validate --spec=draft2020 -s data/equipment.schema.json -d data/equipment.json",
    "validate:weapon-mods": "ajv validate --spec=draft2020 -s data/weapon-mods.schema.json -d data/weapon-mods.json",
    "validate:builds": "ajv validate --spec=draft2020 -s data/builds.schema.json -d \"data/*builds.json\"",
    "validate:catalog-relations": "node data/validate-relations.js"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-cli": "^5.0.0",
    "eslint": "^3.19.0",
    "husky": "^9.1.7",
    "jsondiffpatch": "0.1.38",
    "nodeunit": "0.9.1",
    "typescript": "^5.9.2"
  }
}
